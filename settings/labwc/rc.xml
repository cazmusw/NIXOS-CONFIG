<?xml version="1.0"?>
<labwc_config>
  <core><decoration>server</decoration></core>
  <theme>
    <titlebar><layout>icon:iconify,max,close</layout></titlebar>
  </theme>
  <focus><followMouse>no</followMouse></focus>
  <keyboard>
    <default />
    <keybind key="Print"><action name="Execute" command="flameshot gui" /></keybind>
    <keybind key="W-t"><action name="Execute" command="alacritty" /></keybind>
    <keybind key="W-d"><action name="Execute" command="shellctl launcher" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="W-h"><action name="Iconify" /></keybind>
    <keybind key="W-m"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-f"><action name="ToggleFullscreen" /></keybind>
    <keybind key="W-A-l"><action name="Execute" command="swaylock -f" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl set +5%" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl set 5%-" /></keybind>

  </keyboard>
  <mouse>
    <default />
    <context name="Title">
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
    <context name="Frame">
      <mousebind button="W-Left" action="Drag"><action name="Move" /></mousebind>
      <mousebind button="W-Right" action="Drag"><action name="Resize" /></mousebind>
    </context>
  </mouse>
  <libinput>
    <device category="non-touch">
      <accelProfile>flat</accelProfile>
      <pointerSpeed>0.0</pointerSpeed>
    </device>
  </libinput>
</labwc_config>
